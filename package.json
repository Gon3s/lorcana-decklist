{
  "name": "grimoire-lorcana",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "catalog:update": "node scripts/update-catalog.mjs",
    "serve": "python3 -m http.server 8080 --directory docs",
    "format": "oxfmt --threads=1 --write .",
    "format:check": "oxfmt --threads=1 --check .",
    "build": "node scripts/build.mjs",
    "lint": "oxlint docs scripts tests --deny-warnings && node scripts/check-typography.mjs",
    "lint:fix": "oxlint docs scripts tests --fix"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0"
  },
  "engines": {
    "node": ">=22"
  }
}
